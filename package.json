{
  "name": "fast-jev-opencode",
  "version": "0.1.0",
  "description": "OpenCode v1 plugin: prune stale tool calls and truncate bulky tool results from the outgoing model request using TypeSafe Jev decisions, instead of summarizing context.",
  "type": "module",
  "main": "plugins/fast-jev.ts",
  "exports": {
    ".": "./plugins/fast-jev.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roshan-shaik-ml/fast-jev-opencode.git"
  },
  "homepage": "https://github.com/roshan-shaik-ml/fast-jev-opencode#readme",
  "bugs": {
    "url": "https://github.com/roshan-shaik-ml/fast-jev-opencode/issues"
  },
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jev",
    "typesafe",
    "compaction",
    "context"
  ],
  "scripts": {
    "test": "node --experimental-strip-types fast-jev.test.mjs",
    "bench": "node --experimental-strip-types bench/benchmark.mjs",
    "bench:savings": "node --experimental-strip-types bench/savings.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.32",

  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
