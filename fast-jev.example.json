{
  "enabled": true,
  "dryRun": true,
  "provider": "typesafe",
  "keepCallThreshold": 0.25,
  "keepResultThreshold": 0.15,
  "questionStyle": "choice",
  "preserveRecentMessages": 6,
  "maxStateTokens": 25000,
  "maxRequestTokens": 30000,
  "truncateHeadChars": 300,
  "minResultChars": 2000,
  "peekChars": 200,
  "minScored": 8,
  "removedCallStyle": "stub",
  "rules": {
    "duplicate": true,
    "superseded": false,
    "resolved": true
  },
  "inputPrice": 0,
  "cachedInputPrice": 0,
  "cacheAware": false,
  "protectTools": [],
  "rejudgeAfterMs": 600000,
  "timeoutMs": 30000,
  "log": true
}
