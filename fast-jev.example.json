{
  "enabled": true,
  "dryRun": true,
  "provider": "typesafe",
  "keepCallThreshold": 0.5,
  "keepResultThreshold": 0.25,
  "preserveRecentMessages": 6,
  "maxStateTokens": 25000,
  "maxRequestTokens": 30000,
  "truncateHeadChars": 300,
  "minResultChars": 2000,
  "peekChars": 200,
  "minScored": 8,
  "removedCallStyle": "stub",
  "protectTools": [],
  "rejudgeAfterMs": 600000,
  "timeoutMs": 30000,
  "log": true
}
